<ui:FluentWindow x:Class="MonsterKontrol.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Monster Kontrol"
                 Width="1150" Height="760" MinWidth="900" MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Monster Kontrol">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Grid24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="8,4,8,8" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="KLAVYE" Margin="12,4,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <ListBox x:Name="KlavyeMenu" SelectionChanged="Menu_SelectionChanged" ItemContainerStyle="{StaticResource MenuOgesi}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Klavye">
                    <ListBoxItem Tag="isik" AutomationProperties.Name="Işık">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Lightbulb24" Margin="0,0,12,0" />
                            <TextBlock Text="Işık" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="efektler" AutomationProperties.Name="Efektler">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Sparkle24" Margin="0,0,12,0" />
                            <TextBlock Text="Efektler" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
                <TextBlock Text="PERFORMANS" Margin="12,16,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <ListBox x:Name="PerformansMenu" SelectionChanged="Menu_SelectionChanged" ItemContainerStyle="{StaticResource MenuOgesi}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Performans">
                    <ListBoxItem Tag="pano" AutomationProperties.Name="Pano">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Gauge24" Margin="0,0,12,0" />
                            <TextBlock Text="Pano" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="uygulamalar" AutomationProperties.Name="Uygulamalar">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Apps24" Margin="0,0,12,0" />
                            <TextBlock Text="Uygulamalar" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="fan" AutomationProperties.Name="Fan">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="WeatherSqualls24" Margin="0,0,12,0" />
                            <TextBlock Text="Fan" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="profiller" AutomationProperties.Name="Profiller">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Options24" Margin="0,0,12,0" />
                            <TextBlock Text="Profiller" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
                </StackPanel>
                <ListBox DockPanel.Dock="Bottom" x:Name="AltMenu" SelectionChanged="Menu_SelectionChanged" ItemContainerStyle="{StaticResource MenuOgesi}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Ayarlar">
                    <ListBoxItem Tag="klavye-ayar" AutomationProperties.Name="Klavye ayarları">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Keyboard24" Margin="0,0,12,0" />
                            <TextBlock Text="Klavye ayarları" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="ayarlar" AutomationProperties.Name="Performans ayarları">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0" />
                            <TextBlock Text="Performans ayarları" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="1" CornerRadius="10,0,0,0" BorderThickness="1,1,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <ContentControl x:Name="Icerik" />
                    <ui:InfoBar x:Name="HataCubugu" VerticalAlignment="Bottom" Margin="20" IsOpen="False"
                                Severity="Warning" IsClosable="True" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
