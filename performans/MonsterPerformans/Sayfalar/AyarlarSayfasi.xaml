<UserControl x:Class="MonsterPerformans.Sayfalar.AyarlarSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <!-- Monster Klavye Ayarlar sayfasıyla aynı satır görünümü -->
        <Style x:Key="Satir" TargetType="Border" BasedOn="{StaticResource Kart}">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Bolum" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,8" />
        </Style>
        <Style x:Key="Aciklama" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,20">
            <TextBlock Text="Ayarlar" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />

            <TextBlock Text="Başlangıç" Style="{StaticResource Bolum}" />
            <Border Style="{StaticResource Satir}">
                <DockPanel>
                    <ui:ToggleSwitch x:Name="Baslat" DockPanel.Dock="Right" Checked="Baslat_Click" Unchecked="Baslat_Click"
                                     AutomationProperties.Name="Windows ile başlat" />
                    <StackPanel>
                        <TextBlock Text="Windows ile başlat" FontSize="14" />
                        <TextBlock Text="Oturum açılınca tepside başlar."
                                   Style="{StaticResource Aciklama}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Satir}">
                <DockPanel>
                    <ui:ToggleSwitch x:Name="Yeniden" DockPanel.Dock="Right" Checked="Ayar_Degisti" Unchecked="Ayar_Degisti"
                                     AutomationProperties.Name="Son profili yeniden uygula" />
                    <StackPanel>
                        <TextBlock Text="Açılışta ve uykudan dönüşte son profili yeniden uygula" FontSize="14" />
                        <TextBlock Style="{StaticResource Aciklama}"
                                   Text="Özel fan eğrisi yeniden başlatmada sıfırlanır. Açıksa son seçilen profil 3 sn sonra yeniden yazılır; kapalıysa açılışta donanıma bir şey yazılmaz." />
                        <TextBlock x:Name="SonProfilYazisi" Style="{StaticResource Aciklama}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="Güvenlik" Style="{StaticResource Bolum}" />
            <Border Style="{StaticResource Satir}">
                <DockPanel>
                    <ui:Button x:Name="GuvenliDugmesi" DockPanel.Dock="Right" Content="Güvenli duruma dön" Margin="14,0,0,0"
                               Icon="{ui:SymbolIcon ShieldCheckmark24}" Click="Guvenli_Click" />
                    <StackPanel>
                        <TextBlock Text="Güvenli durum" FontSize="14" />
                        <TextBlock Text="Fan otomatik, güç seviyesi Eğlence, Windows planı Dengeli." Style="{StaticResource Aciklama}" />
                        <TextBlock x:Name="GuvenliSonuc" Style="{StaticResource Aciklama}" Visibility="Collapsed" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Satir}">
                <DockPanel>
                    <ComboBox x:Name="Esik" DockPanel.Dock="Right" Width="110" VerticalAlignment="Center" SelectionChanged="Ayar_Degisti"
                              AutomationProperties.Name="Acil durum eşiği" />
                    <StackPanel>
                        <TextBlock Text="Acil durum eşiği" FontSize="14" />
                        <TextBlock Style="{StaticResource Aciklama}"
                                   Text="CPU bu sıcaklıkta 3 sn kalırsa (ya da GPU 87°C'yi bulursa) önce frekans kısılır, 30 sn sonra hâlâ sıcaksa fanlar en yükseğe, sonra güç Sessiz'e iner. 85°C altında 60 sn kalınca profil geri gelir. Normal yükte CPU 90–91°C'de dengelenir; bu yüzden 92'nin altı seçilemez." />
                        <TextBlock x:Name="AcilYazisi" Style="{StaticResource Aciklama}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Satir}">
                <DockPanel>
                    <ComboBox x:Name="Politika" DockPanel.Dock="Right" Width="230" VerticalAlignment="Center" SelectionChanged="Ayar_Degisti"
                              AutomationProperties.Name="Eğri doğrulanamazsa">
                        <ComboBoxItem Content="Yalnız fan otomatiğe dönsün" />
                        <ComboBoxItem Content="Her şey güvenli duruma dönsün" />
                    </ComboBox>
                    <StackPanel>
                        <TextBlock Text="Fan eğrisi doğrulanamazsa" FontSize="14" />
                        <TextBlock Style="{StaticResource Aciklama}"
                                   Text="Eğri bir kez daha denenir. Yine geri okunamazsa fan her durumda otomatiğe döner; ikinci seçenek güç seviyesini ve Windows planını da güvenli duruma alır." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Satir}">
                <StackPanel>
                    <TextBlock Text="Çıkışta fan" FontSize="14" />
                    <TextBlock Style="{StaticResource Aciklama}"
                               Text="Bu oturumda fan Maksimum ya da Özel eğriye alındıysa, uygulamadan çıkarken otomatiğe döner (izleyen kalmaz)." />
                </StackPanel>
            </Border>

            <TextBlock Text="İşlemci" Style="{StaticResource Bolum}" />
            <Border Style="{StaticResource Satir}">
                <DockPanel>
                    <ui:NumberBox x:Name="EnYuksekMhz" DockPanel.Dock="Right" Width="150" VerticalAlignment="Center"
                                  Minimum="1000" Maximum="6500" SmallChange="100" LargeChange="500" MaxDecimalPlaces="0"
                                  ClearButtonEnabled="False" ValueChanged="Ayar_Degisti" AutomationProperties.Name="En yüksek frekans (MHz)" />
                    <StackPanel>
                        <TextBlock Text="En yüksek frekans (MHz)" FontSize="14" />
                        <TextBlock Style="{StaticResource Aciklama}"
                                   Text="İşlemcinizin en yüksek turbo frekansı. Profillerdeki frekans yüzdesi bu değere göre MHz'e çevrilir (ör. %80 × 4100 = 3280 MHz). Varsayılan 4100: i5-10200H. Değişiklik profil bir sonraki uygulanışında geçerli olur." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="Kayıt" Style="{StaticResource Bolum}" />
            <Border Style="{StaticResource Satir}">
                <StackPanel>
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="Kayit" DockPanel.Dock="Right" Checked="Ayar_Degisti" Unchecked="Ayar_Degisti"
                                         AutomationProperties.Name="Ölçüm kaydı tut" />
                        <StackPanel>
                            <TextBlock Text="Ölçüm kaydı tut" FontSize="14" />
                            <TextBlock Style="{StaticResource Aciklama}"
                                       Text="Saniyede bir satır, günde bir CSV (yaklaşık 40 MB): sensörler, Windows güç ayarları ve ön plandaki programın adı (pencere başlığı tutulmaz). 30 günden eskiler ozet klasörüne dakikalık özet olarak iner; özetler silinmez. Profil, acil durum ve doğrulama olayları olaylar.log'a yazılır." />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <ui:Button DockPanel.Dock="Right" Content="Değiştir" Margin="8,0,0,0" Click="KlasorDegistir_Click" />
                        <ui:Button DockPanel.Dock="Right" Content="Klasörü aç" Margin="8,0,0,0" Icon="{ui:SymbolIcon FolderOpen24}"
                                   Click="KlasorAc_Click" />
                        <TextBlock x:Name="KlasorYazisi" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Donanım" Style="{StaticResource Bolum}" />
            <Border Style="{StaticResource Satir}">
                <DockPanel>
                    <Ellipse x:Name="DchuNoktasi" Width="10" Height="10" Margin="0,0,14,0" Fill="#2BD96B" />
                    <StackPanel>
                        <TextBlock x:Name="DchuBaslik" Text="Clevo sürücüsü bulundu" FontSize="14" />
                        <TextBlock x:Name="DchuAyrinti" Style="{StaticResource Aciklama}" FontFamily="Consolas" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Satir}">
                <DockPanel>
                    <Ellipse x:Name="NvmlNoktasi" Width="10" Height="10" Margin="0,0,14,0" Fill="#2BD96B" />
                    <StackPanel>
                        <TextBlock x:Name="NvmlBaslik" Text="NVIDIA sürücüsü (NVML) bulundu" FontSize="14" />
                        <TextBlock Text="GPU sıcaklığı, frekansı ve gücü buradan okunur." Style="{StaticResource Aciklama}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="Monster Performans" Margin="0,14,0,0"
                       FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
