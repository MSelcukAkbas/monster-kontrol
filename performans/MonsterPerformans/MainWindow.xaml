<ui:FluentWindow x:Class="MonsterPerformans.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Monster Performans"
                 Width="1100" Height="740" MinWidth="900" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Monster Performans">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Temperature24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="8,4,8,8" LastChildFill="False">
                <ListBox x:Name="Menu" DockPanel.Dock="Top" SelectionChanged="Menu_SelectionChanged" ItemContainerStyle="{StaticResource MenuOgesi}"
                         Background="Transparent" BorderThickness="0" AutomationProperties.Name="Bölümler">
                    <ListBoxItem Tag="pano" IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Gauge24" Margin="0,0,12,0" />
                            <TextBlock Text="Pano" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="fan">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="WeatherSqualls24" Margin="0,0,12,0" />
                            <TextBlock Text="Fan" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="profiller">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Options24" Margin="0,0,12,0" />
                            <TextBlock Text="Profiller" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
                <ListBox x:Name="AltMenu" DockPanel.Dock="Bottom" SelectionChanged="Menu_SelectionChanged" ItemContainerStyle="{StaticResource MenuOgesi}"
                         Background="Transparent" BorderThickness="0" AutomationProperties.Name="Ayarlar menüsü">
                    <ListBoxItem Tag="ayarlar">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0" />
                            <TextBlock Text="Ayarlar" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="1" CornerRadius="10,0,0,0" BorderThickness="1,1,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <ContentControl x:Name="Icerik" />
                    <ui:InfoBar x:Name="HataCubugu" VerticalAlignment="Bottom" Margin="20" IsOpen="False"
                                Severity="Error" Title="Donanıma ulaşılamıyor" IsClosable="False" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
