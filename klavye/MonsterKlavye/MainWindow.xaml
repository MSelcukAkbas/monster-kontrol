<ui:FluentWindow x:Class="MonsterKlavye.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Monster Klavye"
                 Width="1100" Height="740" MinWidth="900" MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Monster Klavye">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Keyboard24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Yan menü: tasarımdaki gibi, solda vurgu çizgili seçili öğe -->
            <DockPanel Grid.Column="0" Margin="8,4,8,8" LastChildFill="False">
                <ListBox x:Name="Menu" DockPanel.Dock="Top" SelectionChanged="Menu_SelectionChanged" ItemContainerStyle="{StaticResource MenuOgesi}"
                         Background="Transparent" BorderThickness="0" AutomationProperties.Name="Bölümler">
                    <ListBoxItem x:Name="MenuIsik" Tag="isik" IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Lightbulb24" Margin="0,0,12,0" />
                            <TextBlock Text="Işık" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="efektler">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Sparkle24" Margin="0,0,12,0" />
                            <TextBlock Text="Efektler" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
                <ListBox x:Name="AltMenu" DockPanel.Dock="Bottom" SelectionChanged="Menu_SelectionChanged" ItemContainerStyle="{StaticResource MenuOgesi}"
                         Background="Transparent" BorderThickness="0" AutomationProperties.Name="Ayarlar menüsü">
                    <ListBoxItem Tag="ayarlar">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0" />
                            <TextBlock Text="Ayarlar" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="1" CornerRadius="10,0,0,0" BorderThickness="1,1,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <ContentControl x:Name="Icerik" />
                    <ui:InfoBar x:Name="HataCubugu" VerticalAlignment="Bottom" Margin="20" IsOpen="False"
                                Severity="Error" Title="Klavyeye ulaşılamıyor" IsClosable="False" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
