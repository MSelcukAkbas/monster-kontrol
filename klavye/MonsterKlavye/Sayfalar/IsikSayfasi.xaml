<UserControl x:Class="MonsterKlavye.Sayfalar.IsikSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <!-- Yuvarlak güç düğmesi -->
        <Style x:Key="GucDugmesi" TargetType="ToggleButton">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Ellipse x:Name="Zemin" Fill="#2B2B2F" Stroke="#55555B" StrokeThickness="1" />
                            <ui:SymbolIcon x:Name="Ikon" Symbol="Power24" FontSize="24" Foreground="#C8C8CC" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Zemin" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Zemin" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Ikon" Property="Foreground" Value="#111111" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Zemin" Property="StrokeThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="330" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sahne: klavye ve arkasına yayılan ışık -->
        <Border Grid.Row="0" CornerRadius="14" ClipToBounds="True" Background="#141416"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.66" GradientOrigin="0.5,0.66" RadiusX="0.62" RadiusY="0.8">
                            <GradientStop x:Name="Parilti" Offset="0" Color="#88FF6A00" />
                            <GradientStop Offset="0.65" Color="#00000000" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel Margin="24,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Text="KLAVYE IŞIĞI" FontSize="12" Foreground="#B8B8BD" />
                    <TextBlock x:Name="RenkAdi" Text="Ateş turuncusu" FontSize="30" FontWeight="SemiBold" Margin="0,2,0,2" />
                    <TextBlock x:Name="DurumYazi" Text="Açık · %80 parlaklık" FontSize="13" Foreground="#C8C8CC" />
                </StackPanel>

                <ToggleButton x:Name="GucDugmesi" Style="{StaticResource GucDugmesi}"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,22,0"
                              Checked="Guc_Click" Unchecked="Guc_Click" AutomationProperties.Name="Klavye ışığını aç veya kapat"
                              ToolTip="Aç / kapat" />

                <Border Width="580" VerticalAlignment="Bottom" Margin="0,0,0,20"
                        Padding="10" CornerRadius="12" Background="#1D1D20" BorderBrush="#3A3A40" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect x:Name="KasaParilti" ShadowDepth="0" BlurRadius="60" Opacity="0.6" Color="#FF6A00" />
                    </Border.Effect>
                    <StackPanel x:Name="TusSatirlari" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Renk -->
            <Border Grid.Column="0" Style="{StaticResource Kart}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Renk" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ui:TextBox x:Name="HexKutusu" DockPanel.Dock="Right" Width="110" HorizontalAlignment="Right"
                                    FontFamily="Consolas" Text="#FF6A00" ClearButtonEnabled="False"
                                    KeyDown="Hex_KeyDown" LostKeyboardFocus="Hex_LostFocus"
                                    AutomationProperties.Name="Renk kodu (HEX)" />
                        <TextBlock Text="HEX" DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Foreground="#C8C8CC" FontSize="12" />
                    </DockPanel>

                    <!-- Ton şeridi: tıkla / sürükle / ok tuşları -->
                    <Grid x:Name="TonSerit" Height="26" Margin="0,18,0,0" Focusable="True" Cursor="Hand"
                          Background="Transparent" AutomationProperties.Name="Renk tonu"
                          MouseLeftButtonDown="Ton_MouseDown" MouseMove="Ton_MouseMove" MouseLeftButtonUp="Ton_MouseUp"
                          KeyDown="Ton_KeyDown" SizeChanged="Ton_SizeChanged">
                        <Border Height="14" CornerRadius="7">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#FF0000" />
                                    <GradientStop Offset="0.1667" Color="#FFFF00" />
                                    <GradientStop Offset="0.3333" Color="#00FF00" />
                                    <GradientStop Offset="0.5" Color="#00FFFF" />
                                    <GradientStop Offset="0.6667" Color="#0000FF" />
                                    <GradientStop Offset="0.8333" Color="#FF00FF" />
                                    <GradientStop Offset="1" Color="#FF0000" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas>
                            <Ellipse x:Name="TonIsaret" Width="24" Height="24" Canvas.Top="1"
                                     Stroke="White" StrokeThickness="3" Fill="Transparent">
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.6" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>

                    <!-- ItemsControl değil: orada UIA renk düğmelerine ulaşamıyor -->
                    <StackPanel x:Name="Hazirlar" Orientation="Horizontal" Margin="0,18,0,0" />
                </StackPanel>
            </Border>

            <!-- Parlaklık -->
            <Border Grid.Column="2" Style="{StaticResource Kart}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Parlaklık" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="ParlaklikYazi" Text="%80" FontSize="26" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                    </DockPanel>
                    <Slider x:Name="ParlaklikKaydirici" Minimum="0" Maximum="100" Value="80" Margin="0,14,0,0"
                            SmallChange="5" LargeChange="10" IsMoveToPointEnabled="True"
                            ValueChanged="Parlaklik_ValueChanged" AutomationProperties.Name="Parlaklık" />
                    <UniformGrid Columns="4" Margin="0,14,0,0">
                        <ui:Button Content="%25" Tag="25" Click="Kademe_Click" Margin="0,0,6,0" HorizontalAlignment="Stretch" />
                        <ui:Button Content="%50" Tag="50" Click="Kademe_Click" Margin="3,0,3,0" HorizontalAlignment="Stretch" />
                        <ui:Button Content="%75" Tag="75" Click="Kademe_Click" Margin="3,0,3,0" HorizontalAlignment="Stretch" />
                        <ui:Button Content="%100" Tag="100" Click="Kademe_Click" Margin="6,0,0,0" HorizontalAlignment="Stretch" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
