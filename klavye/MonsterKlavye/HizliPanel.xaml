<Window x:Class="MonsterKlavye.HizliPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Monster Klavye hızlı panel"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" ShowActivated="True"
        Deactivated="Window_Deactivated" KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- Tasarımdaki düz panel düğmesi; etkin efekt (Tag=secili): vurgu çerçeve + hafif vurgu zemin -->
        <Style x:Key="PanelDugmesi" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cerceve" CornerRadius="6" BorderThickness="1" BorderBrush="#4A4A4A" Background="#373737">
                            <Grid>
                                <Border x:Name="Ton" CornerRadius="5" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cerceve" Property="Background" Value="#404040" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cerceve" Property="Background" Value="#2F2F2F" />
                            </Trigger>
                            <Trigger Property="Tag" Value="secili">
                                <Setter TargetName="Cerceve" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Ton" Property="Opacity" Value="0.15" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Cerceve" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Tasarımdaki köşeli renk karesi; seçiliyse beyaz çerçeve -->
        <Style x:Key="PanelRengi" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Kare" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="#40000000" BorderThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Kare" Property="BorderBrush" Value="#80FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Kare" Property="BorderBrush" Value="#80FFFFFF" />
                                <Setter TargetName="Kare" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="Tag" Value="secili">
                                <Setter TargetName="Kare" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Kare" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Width="340" Margin="12" Padding="16" CornerRadius="10"
            Background="#F22B2B2B" BorderBrush="#444444" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" />
        </Border.Effect>
        <StackPanel>
            <DockPanel>
                <Border x:Name="Ornek" Width="14" Height="14" CornerRadius="4" Margin="0,0,10,0" Background="#FF6A00" />
                <ui:ToggleSwitch x:Name="Guc" DockPanel.Dock="Right" Checked="Guc_Click" Unchecked="Guc_Click"
                                 AutomationProperties.Name="Klavye ışığı açık" />
                <TextBlock Text="Klavye ışığı" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <DockPanel Margin="0,14,0,0">
                <ui:SymbolIcon Symbol="BrightnessHigh24" Margin="0,0,10,0" Foreground="#C5C5C5" />
                <TextBlock x:Name="ParlaklikYazi" DockPanel.Dock="Right" Width="38" TextAlignment="Right"
                           VerticalAlignment="Center" Text="%80" />
                <Slider x:Name="Parlaklik" Minimum="0" Maximum="100" VerticalAlignment="Center"
                        IsMoveToPointEnabled="True" ValueChanged="Parlaklik_ValueChanged"
                        AutomationProperties.Name="Parlaklık" />
            </DockPanel>

            <!-- Renk düğmeleri kodda HazirRenkler'den (ItemsControl değil: orada UIA düğmeye ulaşamıyor) -->
            <UniformGrid x:Name="Renkler" Rows="1" Margin="0,16,0,0" />

            <UniformGrid x:Name="EfektDugmeleri" Rows="1" Margin="0,16,0,0" />

            <Button Content="Monster Klavye'yi aç" Style="{StaticResource PanelDugmesi}" FontSize="13" Margin="0,12,0,0"
                    Click="Ac_Click" />
        </StackPanel>
    </Border>
</Window>
